{
  "name": "hardstuck",
  "private": true,
  "version": "0.2.0",
  "description": "HardStuck — matched-pool ranked boosting platform",
  "scripts": {
    "dev": "pnpm --filter @hardstuck/web dev",
    "build": "pnpm --filter @hardstuck/shared build && pnpm --filter @hardstuck/web build",
    "lint": "pnpm -r --filter @hardstuck/web --filter @hardstuck/shared run lint",
    "db:push": "pnpm --filter @hardstuck/web db:push",
    "db:studio": "pnpm --filter @hardstuck/web db:studio",
    "seed:admin": "pnpm --filter @hardstuck/web exec tsx --env-file=.env scripts/seed-admin.ts",
    "seed:listings": "pnpm --filter @hardstuck/web exec tsx --env-file=.env scripts/seed-listings.ts",
    "demo:lol-offer": "pnpm --filter @hardstuck/web exec tsx --env-file=.env scripts/demo-lol-offer-notification.ts auto",
    "seed:booster-queue": "pnpm --filter @hardstuck/web exec tsx --env-file=.env scripts/seed-booster-queue.ts 5",
    "backup:pg": "powershell -ExecutionPolicy Bypass -File ./scripts/backup-pg.ps1",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "cron:orders": "curl -s -X POST -H \"Authorization: Bearer $env:CRON_SECRET\" http://localhost:3000/api/cron/orders"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
