# Shared / API
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/hardstuck
MONGODB_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-random-256-bit-key
JWT_REFRESH_SECRET=change-me-to-another-random-256-bit-key
JWT_ACCESS_EXPIRES=24h
JWT_REFRESH_EXPIRES=30d

# Paymob (USD default; multi-currency supported)
PAYMOB_SECRET_KEY=sk_test_xxx
PAYMOB_PUBLIC_KEY=pk_test_xxx
PAYMOB_HMAC_SECRET=your_hmac_secret
PAYMOB_INTEGRATION_ID_CARD=123456
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_DEFAULT_CURRENCY=USD
# Comma-separated list of supported currencies
PAYMOB_SUPPORTED_CURRENCIES=USD,EGP,AED,SAR,EUR,GBP

# Optional integrations (placeholders)
RIOT_API_KEY=
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=hardstuck-uploads
SENTRY_DSN=

# Seed admin (used by seed script)
SEED_ADMIN_EMAIL=admin@hardstuck.local
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_ADMIN_USERNAME=admin

# Frontend (apps/web) — copy relevant vars into apps/web/.env
VITE_API_URL=http://localhost:5000
VITE_WS_URL=http://localhost:5000
VITE_PAYMOB_PUBLIC_KEY=pk_test_xxx
VITE_DEFAULT_CURRENCY=USD
