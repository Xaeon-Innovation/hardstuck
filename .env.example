# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Docker Compose defaults)
DATABASE_URL=postgresql://hardstuck:hardstuck@localhost:5434/hardstuck

# Redis
REDIS_URL=redis://localhost:6380

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000

# Payments
# Use `manual` until Polar AUP approval; then `polar`
PAYMENT_PROVIDER=manual
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
# sandbox | production
POLAR_SERVER=sandbox
# Webhook URL to register in Polar: {NEXT_PUBLIC_APP_URL}/api/webhooks/polar

# Cron (Bearer token for /api/cron/orders)
CRON_SECRET=change-me-cron-secret

# Credential vault (Phase 4) — 32-byte key
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_ENCRYPTION_KEY=

# Display FX (EUR per 1 USD)
EUR_PER_USD=0.92
NEXT_PUBLIC_EUR_PER_USD=0.92

# Seed / promote admin
SEED_ADMIN_EMAIL=admin@hardstuck.local
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_ADMIN_NAME=Admin

# Closed beta — require client invite codes on register
CLOSED_BETA=true

# Email (optional — console fallback when unset)
RESEND_API_KEY=
EMAIL_FROM=HardStuck <noreply@hardstuck.gg>
